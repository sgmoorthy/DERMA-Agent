# Example Streamlit secrets file for local development or Streamlit Community Cloud
#
# Copy to `.streamlit/secrets.toml` locally (do not commit the real file),
# or paste the contents into Streamlit Community Cloud > App settings > Secrets.

OPENAI_API_KEY = "sk-..."
GOOGLE_API_KEY = "AIza..."

# Optional grouped form also supported by the app:
# [api_keys]
# openai_api_key = "sk-..."
# google_api_key = "AIza..."
